# Altiora 环境变量模板
# 用法：复制本文件为 .env 后按需修改。全部留空也能正常运行（零外部依赖模式）。

# ── 服务端口 ──────────────────────────────────────────
PORT=8000

# ── 离线语音模型路径（可选）────────────────────────────
# 默认使用仓库内置的 Altiora/backend/model/vosk-model-small-cn-0.22
# 如需换用其他 Vosk 中文模型，填写其绝对路径即可
VOSK_MODEL_PATH=

# ── 大模型接入（预留，当前版本未启用）──────────────────
# 留空时系统走内置话术模板，功能完整可用。
# 兼容 OpenAI 协议的服务均可：豆包/火山方舟、DeepSeek、通义、Kimi 等
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# Altiora 环境变量模板
# 用法：复制本文件为 .env 后按需修改。全部留空也能正常运行（零外部依赖模式）。

# ── 服务端口 ──────────────────────────────────────────
PORT=8000

# ── 离线语音模型路径（可选）────────────────────────────
# 默认使用仓库内置的 Altiora/backend/model/vosk-model-small-cn-0.22
# 如需换用其他 Vosk 中文模型，填写其绝对路径即可
VOSK_MODEL_PATH=

# ── 大模型接入（只负责「听懂」和「说话」）──────────────
# 留空：前端显示「本地规则」，用内置规则跑，功能完整、离线可用。
# 填了：前端显示「AI 在线」，口语化输入能被理解，话术也不再重复。
#
# 注意：这里填的是「这台机器的主人」自己的 Key。
# 如果要把网站开放给别人用，不要在这里填——让每个人点页面右上角
# 的「本地规则 / AI 在线」标签，填自己的 Key（只存在他自己的浏览器里）。
#
# 兼容 OpenAI 协议的服务都能用，示例：
#   硅基流动    LLM_BASE_URL=https://api.siliconflow.cn/v1                  LLM_MODEL=Qwen/Qwen2.5-7B-Instruct  # ¥0 免费模型
#   DeepSeek    LLM_BASE_URL=https://api.deepseek.com/v1            LLM_MODEL=deepseek-chat
#   通义千问    LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1  LLM_MODEL=qwen-plus
#   火山方舟    LLM_BASE_URL=https://ark.cn-beijing.volces.com/api/v3          LLM_MODEL=你的接入点ID
#   OpenAI      LLM_BASE_URL=https://api.openai.com/v1               LLM_MODEL=gpt-4o-mini
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=

# ── 限流（服务器上配了 Key 时才有用）─────────────────────────
# 免费 Key 额度有限，防止被刷爆。只对调大模型的 /api/understand 和 /api/say 生效。
# 评委体验几十轮完全够；被刷到上限后前端会自动回退本地规则，不影响使用。
# 每个 IP 每天最多调多少次大模型
RATE_PER_IP_DAY=50
# 全服务器每天总上限
RATE_GLOBAL_DAY=1000
